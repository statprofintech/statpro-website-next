# Set these in Vercel → Project Settings → Environment Variables.
# All NEXT_PUBLIC_* vars are baked into the client bundle.

# Google Tag Manager container (loads GA4 internally).
NEXT_PUBLIC_GTM_ID=GTM-537TPHW

# CRM backend the borrower portal + apply form talk to.
NEXT_PUBLIC_CRM_API_URL=https://crm.statproindia.com

# Search-console verification (paste bare tokens, not full meta tags).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
